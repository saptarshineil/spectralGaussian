ninja_required_version = 1.3
cxx = /usr/bin/g++-10
nvcc = /usr/bin/nvcc

cflags = -Wno-unused-result -Wsign-compare -DNDEBUG -fwrapv -O2 -Wall -fPIC -O2 -isystem /home/ssinha/anaconda3/envs/gaussian_grouping/include -fPIC -O2 -isystem /home/ssinha/anaconda3/envs/gaussian_grouping/include -fPIC -I/home/ssinha/anaconda3/envs/gaussian_grouping/lib/python3.8/site-packages/torch/include -I/home/ssinha/anaconda3/envs/gaussian_grouping/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/home/ssinha/anaconda3/envs/gaussian_grouping/lib/python3.8/site-packages/torch/include/TH -I/home/ssinha/anaconda3/envs/gaussian_grouping/lib/python3.8/site-packages/torch/include/THC -I/home/ssinha/anaconda3/envs/gaussian_grouping/include/python3.8 -c
post_cflags = -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -std=c++14
cuda_cflags = -I/home/ssinha/anaconda3/envs/gaussian_grouping/lib/python3.8/site-packages/torch/include -I/home/ssinha/anaconda3/envs/gaussian_grouping/lib/python3.8/site-packages/torch/include/torch/csrc/api/include -I/home/ssinha/anaconda3/envs/gaussian_grouping/lib/python3.8/site-packages/torch/include/TH -I/home/ssinha/anaconda3/envs/gaussian_grouping/lib/python3.8/site-packages/torch/include/THC -I/home/ssinha/anaconda3/envs/gaussian_grouping/include/python3.8 -c
cuda_post_cflags = -D__CUDA_NO_HALF_OPERATORS__ -D__CUDA_NO_HALF_CONVERSIONS__ -D__CUDA_NO_BFLOAT16_CONVERSIONS__ -D__CUDA_NO_HALF2_OPERATORS__ --expt-relaxed-constexpr --compiler-options ''"'"'-fPIC'"'"'' -Xcompiler -fno-gnu-unique -I/home/ssinha/dev/multi_modal/sg_multi_modal/submodules/diff-gaussian-rasterization/third_party/glm/ -DTORCH_API_INCLUDE_EXTENSION_H '-DPYBIND11_COMPILER_TYPE="_gcc"' '-DPYBIND11_STDLIB="_libstdcpp"' '-DPYBIND11_BUILD_ABI="_cxxabi1011"' -DTORCH_EXTENSION_NAME=_C -D_GLIBCXX_USE_CXX11_ABI=0 -gencode=arch=compute_86,code=compute_86 -gencode=arch=compute_86,code=sm_86 -ccbin /usr/bin/gcc-10 -std=c++14
ldflags = 

rule compile
  command = $cxx -MMD -MF $out.d $cflags -c $in -o $out $post_cflags
  depfile = $out.d
  deps = gcc

rule cuda_compile
  depfile = $out.d
  deps = gcc
  command = $nvcc  $cuda_cflags -c $in -o $out $cuda_post_cflags



build /home/ssinha/dev/multi_modal/sg_multi_modal/submodules/diff-gaussian-rasterization/build/temp.linux-x86_64-cpython-38/cuda_rasterizer/backward.o: cuda_compile /home/ssinha/dev/multi_modal/sg_multi_modal/submodules/diff-gaussian-rasterization/cuda_rasterizer/backward.cu
build /home/ssinha/dev/multi_modal/sg_multi_modal/submodules/diff-gaussian-rasterization/build/temp.linux-x86_64-cpython-38/cuda_rasterizer/forward.o: cuda_compile /home/ssinha/dev/multi_modal/sg_multi_modal/submodules/diff-gaussian-rasterization/cuda_rasterizer/forward.cu
build /home/ssinha/dev/multi_modal/sg_multi_modal/submodules/diff-gaussian-rasterization/build/temp.linux-x86_64-cpython-38/cuda_rasterizer/rasterizer_impl.o: cuda_compile /home/ssinha/dev/multi_modal/sg_multi_modal/submodules/diff-gaussian-rasterization/cuda_rasterizer/rasterizer_impl.cu
build /home/ssinha/dev/multi_modal/sg_multi_modal/submodules/diff-gaussian-rasterization/build/temp.linux-x86_64-cpython-38/ext.o: compile /home/ssinha/dev/multi_modal/sg_multi_modal/submodules/diff-gaussian-rasterization/ext.cpp
build /home/ssinha/dev/multi_modal/sg_multi_modal/submodules/diff-gaussian-rasterization/build/temp.linux-x86_64-cpython-38/rasterize_points.o: cuda_compile /home/ssinha/dev/multi_modal/sg_multi_modal/submodules/diff-gaussian-rasterization/rasterize_points.cu





